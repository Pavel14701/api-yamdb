# Пример переменных окружения проекта YaMDb.
#
# Значения по умолчанию в settings.py пригодны только для разработки:
# при DEBUG=False (в т.ч. по умолчанию) валидатор настроек запрещает
# запуск с небезопасными значениями. Файл .env никто не читает
# автоматически — задайте переменные окружением (IDE, systemd, docker).

# Режим отладки ('1'/'true'/'yes'/'on'). В проде — не задавать или false.
DEBUG=true

# Секретный ключ Django. Сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Хосты через запятую. '*' запрещён при DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Адрес отправителя писем с кодом подтверждения.
DEFAULT_FROM_EMAIL=noreply@yamdb.example
